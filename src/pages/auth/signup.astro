---
import Layout from "@/layouts/Layout.astro";
import BrandMark from "@/components/BrandMark.astro";
import SignUpForm from "@/components/auth/SignUpForm";

const error = Astro.url.searchParams.get("error");
---

<Layout title="Sign up">
  <div class="bg-cosmic flex min-h-screen flex-col items-center justify-center p-4">
    <div class="mb-6">
      <BrandMark size="md" />
    </div>
    <div class="w-full max-w-sm rounded-2xl border border-white/10 bg-white/10 p-8 text-white backdrop-blur-xl">
      <h1 class="mb-1 text-center text-2xl font-bold text-white">Create your account</h1>
      <p class="mb-6 text-center text-sm text-blue-100/60">Start turning text into flashcards.</p>
      <SignUpForm serverError={error} client:load />
      <p class="mt-4 text-center text-sm text-blue-100/60">
        Already have an account? <a href="/auth/signin" class="text-purple-300 hover:underline">Sign in</a>
      </p>
    </div>
  </div>
</Layout>
