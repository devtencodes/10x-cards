---
import Layout from "@/layouts/Layout.astro";
import BrandMark from "@/components/BrandMark.astro";
import SignInForm from "@/components/auth/SignInForm";

const error = Astro.url.searchParams.get("error");
---

<Layout title="Sign in">
  <div class="bg-cosmic flex min-h-screen flex-col items-center justify-center p-4">
    <div class="mb-6">
      <BrandMark size="md" />
    </div>
    <div class="w-full max-w-sm rounded-2xl border border-white/10 bg-white/10 p-8 text-white backdrop-blur-xl">
      <h1 class="mb-1 text-center text-2xl font-bold text-white">Sign in</h1>
      <p class="mb-6 text-center text-sm text-blue-100/60">Welcome back.</p>
      <SignInForm serverError={error} client:load />
      <p class="mt-4 text-center text-sm text-blue-100/60">
        Don't have an account? <a href="/auth/signup" class="text-purple-300 hover:underline">Sign up</a>
      </p>
    </div>
  </div>
</Layout>
