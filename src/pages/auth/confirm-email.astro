---
import Layout from "@/layouts/Layout.astro";
import BrandMark from "@/components/BrandMark.astro";
import { CircleCheck, MailCheck } from "lucide-react";

const isAutoConfirmed = import.meta.env.DEV;

const content = isAutoConfirmed
  ? {
      icon: CircleCheck,
      heading: "Registration successful",
      description: "Your account has been created. You can now sign in.",
      linkText: "Go to sign in",
    }
  : {
      icon: MailCheck,
      heading: "Check your email",
      description: "We've sent a confirmation link to your email address. Click it to activate your account.",
      linkText: "Back to sign in",
    };
---

<Layout title={content.heading}>
  <div class="bg-cosmic flex min-h-screen flex-col items-center justify-center p-4">
    <div class="mb-6">
      <BrandMark size="md" />
    </div>
    <div
      class="w-full max-w-sm rounded-2xl border border-white/10 bg-white/10 p-8 text-center text-white backdrop-blur-xl"
    >
      <div
        class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-purple-500/20 text-purple-200"
      >
        <content.icon size={24} strokeWidth={1.75} />
      </div>
      <h1 class="mb-3 text-2xl font-bold text-white">{content.heading}</h1>
      <p class="mb-6 text-blue-100/80">{content.description}</p>
      <a href="/auth/signin" class="text-sm text-purple-300 hover:underline">
        {content.linkText}
      </a>
    </div>
  </div>
</Layout>
