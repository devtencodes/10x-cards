---
import AppHeader from "@/components/AppHeader.astro";
import Layout from "@/layouts/Layout.astro";
import { createClient } from "@/lib/supabase";
import StudySession from "@/components/study/StudySession";
import { ArrowLeft, GraduationCap } from "lucide-react";

const supabase = createClient(Astro.request.headers, Astro.cookies);

interface DueCard {
  id: string;
  front: string;
  back: string;
}

let cards: DueCard[] = [];
if (supabase) {
  const { data } = await supabase
    .from("review_schedules")
    .select("flashcards(id, front, back)")
    .lte("due_at", new Date().toISOString())
    .order("due_at", { ascending: true });

  // `flashcard_id` is `not null unique`, so the embedded relation always
  // resolves to exactly one row — no nullable guard needed here.
  cards = (data ?? []).map((row) => row.flashcards);
}
---

<Layout title="Study">
  <div class="bg-cosmic relative min-h-screen w-full overflow-hidden">
    <div
      class="pointer-events-none absolute top-1/4 -left-24 h-[350px] w-[350px] rounded-full bg-purple-500/20 blur-[120px]"
    >
    </div>
    <div
      class="pointer-events-none absolute top-2/3 -right-16 h-[250px] w-[250px] rounded-full bg-blue-500/15 blur-[100px]"
    >
    </div>

    <div class="relative z-10 flex min-h-screen flex-col">
      <AppHeader />

      <main class="mx-auto w-full max-w-2xl flex-1 px-4 py-10 sm:px-8 sm:py-14">
        <a
          href="/dashboard"
          class="mb-6 inline-flex items-center gap-1.5 text-sm text-blue-100/60 transition-colors hover:text-white"
        >
          <ArrowLeft size={14} strokeWidth={2} />
          Dashboard
        </a>

        <div class="mb-8 flex items-center gap-3">
          <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-white/10 text-blue-100">
            <GraduationCap size={20} strokeWidth={1.75} />
          </div>
          <div>
            <h1 class="text-2xl font-bold text-white sm:text-3xl">Study</h1>
            <p class="text-sm text-blue-100/60">Review cards due today.</p>
          </div>
        </div>

        <StudySession client:load cards={cards} />
      </main>
    </div>
  </div>
</Layout>
